// p10_advanced_matrix: triple nested loop
int main() {
    int i = 0;
    int sum = 0;
    int a = 2;
    int b = 3;
    while (i < 10) {
        int j = 0;
        while (j < 10) {
            int k = 0;
            while (k < 10) {
                int t = a + b;   // invariant
                sum = sum + t;
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return sum;   // 1000*5 = 5000
}
