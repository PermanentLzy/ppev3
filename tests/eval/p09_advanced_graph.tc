// p09_advanced_graph: nested loops with invariants
int main() {
    int i = 0;
    int sum = 0;
    int a = 3;
    int b = 7;
    while (i < 20) {
        int j = 0;
        while (j < 30) {
            int t = a * b;     // invariant of both loops
            sum = sum + t;
            j = j + 1;
        }
        i = i + 1;
    }
    return sum;   // 20*30*21 = 12600
}
